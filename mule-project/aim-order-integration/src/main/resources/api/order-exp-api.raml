#%RAML 1.0
title: AIM Customer Order Experience API
description: Entry point for customer orders from Salesforce and the B2B portal (training project).
version: v1
baseUri: http://localhost:8081/api
mediaType: application/json
uses:
  aim: libraries/order-types.raml

traits:
  correlated:
    headers:
      x-correlation-id?:
        type: string
        description: Propagated end to end. Generated by Mule when absent.
  idempotent:
    headers:
      Idempotency-Key:
        type: string
        minLength: 8
        maxLength: 64
        description: Client-generated key, unique per business request. Retries MUST reuse the same key.
        example: SF-8015g00000AbCdE
  errors:
    responses:
      400:
        description: Request failed validation.
        body:
          application/json:
            type: aim.ErrorResponse
            example: !include examples/error-response.json
      502:
        description: A downstream system returned an unexpected error.
        body:
          application/json:
            type: aim.ErrorResponse
      503:
        description: A downstream system is unavailable. Retry later with the same Idempotency-Key.
        body:
          application/json:
            type: aim.ErrorResponse

/orders:
  post:
    displayName: Submit customer order
    is: [ correlated, idempotent, errors ]
    body:
      application/json:
        type: aim.OrderRequest
        examples:
          inStock: !include examples/order-request-instock.json
          shortage: !include examples/order-request-shortage.json
    responses:
      201:
        description: Order created in SAP (CONFIRMED or BACKORDERED).
        body:
          application/json:
            type: aim.OrderResponse
            example: !include examples/order-response-201.json
      202:
        description: Order accepted and persisted; ERP confirmation pending (SAP slow or unavailable).
        body:
          application/json:
            type: aim.OrderResponse
            example: !include examples/order-response-202.json
      409:
        description: A request with the same Idempotency-Key is still in progress.
        body:
          application/json:
            type: aim.ErrorResponse
      422:
        description: Business validation failed (customer not orderable, unknown material, SAP rejection, key reused with a different body).
        body:
          application/json:
            type: aim.ErrorResponse

  /{orderId}:
    uriParameters:
      orderId:
        type: string
        pattern: "^AIM-[0-9]{8}-[A-Z0-9]{8}$"
    get:
      displayName: Get order status
      is: [ correlated, errors ]
      responses:
        200:
          body:
            application/json:
              type: aim.OrderResponse
              example: !include examples/order-response-201.json
        404:
          body:
            application/json:
              type: aim.ErrorResponse
