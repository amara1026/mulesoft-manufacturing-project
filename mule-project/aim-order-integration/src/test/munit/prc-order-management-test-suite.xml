    <!-- ===================================================================================== -->
    <munit:test name="T5-blocked-customer-stops-before-reservation-and-sap"
                description="Credit-blocked customer: AIM:CUSTOMER_INVALID, no reservation, no SAP call, idempotency claim released">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock CRM: blocked">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Get customer from CRM System API"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ customerId: "CUST-100234", status: "BLOCKED" }]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request" doc:name="Mock WMS: availability">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Check availability in WMS System API"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ lines: [ { lineNumber: 10, materialNumber: "PMP-CF-200", known: true, availableQty: 8 } ] }]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Order for blocked customer">
                <munit:payload value="#[readUrl('classpath://test-data/order-instock.json', 'application/json')]" mediaType="application/json"/>
                <munit:attributes value="#[{ headers: { 'idempotency-key': 'MUNIT-KEY-T5-0001' } }]"/>
            </munit:set-event>
            <try doc:name="Capture expected error">
                <flow-ref name="prc-create-order-flow" doc:name="Run order saga"/>
                <error-handler>
                    <on-error-continue type="ANY" doc:name="Capture">
                        <set-variable variableName="raisedError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]" doc:name="raisedError"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.raisedError]" is="#[MunitTools::equalTo('AIM:CUSTOMER_INVALID')]" message="error type"/>
            <munit-tools:verify-call processor="http:request" times="0" doc:name="No reservation">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create soft reservation in WMS System API"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <munit-tools:verify-call processor="http:request" times="0" doc:name="No SAP call">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create SAP sales order"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <db:select config-ref="Database_Config" doc:name="Idempotency record left?">
                <db:sql><![CDATA[SELECT COUNT(*) AS cnt FROM idempotency_record WHERE idempotency_key = 'MUNIT-KEY-T5-0001']]></db:sql>
            </db:select>
            <munit-tools:assert-that expression="#[payload[0].cnt as String]" is="#[MunitTools::equalTo('0')]" message="claim released so the client may retry"/>
        </munit:validation>
    </munit:test>

