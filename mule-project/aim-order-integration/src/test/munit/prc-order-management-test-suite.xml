        <munit:execution>
            <munit:set-event doc:name="Order SAP will reject">
                <munit:payload value="#[readUrl('classpath://test-data/order-instock.json', 'application/json')]" mediaType="application/json"/>
                <munit:attributes value="#[{ headers: { 'idempotency-key': 'MUNIT-KEY-T6-0001' } }]"/>
