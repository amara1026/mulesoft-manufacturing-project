            <try doc:name="Capture expected error">
                <flow-ref name="prc-create-order-flow" doc:name="Run order saga"/>
                <error-handler>
                    <on-error-continue type="ANY" doc:name="Capture">
                        <set-variable variableName="raisedError" value="#[error.errorType.namespace ++ ':' ++ error.errorType.identifier]" doc:name="raisedError"/>
                    </on-error-continue>
                </error-handler>
            </try>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[vars.raisedError]" is="#[MunitTools::equalTo('AIM:SAP_BUSINESS_ERROR')]" message="error type"/>
            <munit-tools:verify-call processor="http:request" times="1" doc:name="Compensation executed once">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Release reservation in WMS System API"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
        </munit:validation>
    </munit:test>

    <!-- ===================================================================================== -->
    <munit:test name="T7-sap-unknown-outcome-returns-202-pending-erp"
                description="SAP System API answers 504 (unknown): 202 PENDING_ERP, reservation kept, erp-pending event in outbox">
        <munit:behavior>
            <munit-tools:mock-when processor="http:request" doc:name="Mock CRM: active">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Get customer from CRM System API"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ customerId: "CUST-100234", status: "ACTIVE" }]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request" doc:name="Mock WMS: availability">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Check availability in WMS System API"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ lines: [ { lineNumber: 10, materialNumber: "PMP-CF-200", known: true, availableQty: 8 } ] }]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request" doc:name="Mock WMS: reservation">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create soft reservation in WMS System API"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ reservationId: "RSV-T7" }]' mediaType="application/json"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
            <munit-tools:mock-when processor="http:request" doc:name="Mock SAP: 504">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Create SAP sales order"/>
                </munit-tools:with-attributes>
                <munit-tools:then-return>
                    <munit-tools:payload value='#[{ error: { code: "AIM-SAP-5041", message: "Outcome unknown" } }]' mediaType="application/json"/>
                    <munit-tools:attributes value="#[{ statusCode: 504 }]"/>
                </munit-tools:then-return>
            </munit-tools:mock-when>
        </munit:behavior>
        <munit:execution>
            <munit:set-event doc:name="Order while SAP is down">
                <munit:payload value="#[readUrl('classpath://test-data/order-instock.json', 'application/json')]" mediaType="application/json"/>
                <munit:attributes value="#[{ headers: { 'idempotency-key': 'MUNIT-KEY-T7-0001' } }]"/>
            </munit:set-event>
            <flow-ref name="prc-create-order-flow" doc:name="Run order saga"/>
        </munit:execution>
        <munit:validation>
            <munit-tools:assert-that expression="#[payload.status]" is="#[MunitTools::equalTo('PENDING_ERP')]" message="status"/>
            <munit-tools:assert-that expression="#[vars.httpStatus as String]" is="#[MunitTools::equalTo('202')]" message="HTTP status"/>
            <munit-tools:verify-call processor="http:request" times="0" doc:name="No compensation on unknown outcome">
                <munit-tools:with-attributes>
                    <munit-tools:with-attribute attributeName="doc:name" whereValue="Release reservation in WMS System API"/>
                </munit-tools:with-attributes>
            </munit-tools:verify-call>
            <set-variable variableName="createdOrderId" value="#[payload.orderId]" doc:name="createdOrderId"/>
            <db:select config-ref="Database_Config" doc:name="Outbox rows for order">
                <db:sql><![CDATA[SELECT event_type FROM outbox_event WHERE aggregate_id = :id]]></db:sql>
                <db:input-parameters><![CDATA[#[{ id: vars.createdOrderId }]]]></db:input-parameters>
            </db:select>
            <munit-tools:assert-that expression="#[payload.event_type contains 'order.erp-pending']" is="#[MunitTools::equalTo(true)]" message="erp-pending event"/>
        </munit:validation>
    </munit:test>
</mule>
